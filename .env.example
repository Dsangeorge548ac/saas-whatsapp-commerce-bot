# Públicas (llegan al navegador; nunca secretos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base de todas las URLs absolutas (emails, redirecciones). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dominio base de las tiendas públicas (empresa.<dominio>). En local: localhost:3000
NEXT_PUBLIC_STORE_BASE_DOMAIN=localhost:3000
# Nombre de la marca (provisional; se muestra junto al logo)
NEXT_PUBLIC_APP_NAME=Astra

# Solo servidor (sin prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# WhatsApp (una sola app de Meta para todos los comercios). Webhook: <APP_URL>/api/webhooks/whatsapp
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Opcionales: versión de la Graph API (verificar la vigente en la documentación de Meta) y modo simulado
# de desarrollo (no llama a Meta; se ignora en producción).
# META_GRAPH_VERSION=v23.0
# WHATSAPP_DRY_RUN=1
# Stripe (suscripciones). Modo TEST en local: sk_test_… ; los planes se crean con `npm run stripe:setup`.
# El secreto del webhook (whsec_…) sale de `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# en local, o del endpoint registrado en el panel de Stripe (<APP_URL>/api/webhooks/stripe) en producción.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
